// Configured by CMake (cmake/Payload.cmake) - paths are absolute.
#include <winres.h>
#include "@UF_RES_DIR@/resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP ICON "@UF_RES_DIR@/app.ico"

IDR_PAYLOAD RCDATA "@UF_PAYLOAD_ZIP@"

IDR_FONT_UI RCDATA "@UF_RES_DIR@/fonts/IBMPlexSans-Regular.ttf"
IDR_FONT_UI_BOLD RCDATA "@UF_RES_DIR@/fonts/IBMPlexSans-SemiBold.ttf"
IDR_FONT_ICONS RCDATA "@UF_RES_DIR@/fonts/Phosphor.ttf"
IDR_FONT_ICONS_BOLD RCDATA "@UF_RES_DIR@/fonts/Phosphor-Bold.ttf"
IDR_FONT_MONO RCDATA "@UF_RES_DIR@/fonts/IBMPlexMono-Regular.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "maksqi"
            VALUE "FileDescription", "UltraFuck Setup"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "uf-installer"
            VALUE "OriginalFilename", "uf-installer.exe"
            VALUE "ProductName", "UltraFuck Setup"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
